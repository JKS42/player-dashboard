{
  "name": "player-dashboard",
  "version": "1.0.0",
  "description": "Gamifying my life that includes push notifications and daily check-ins",
  "homepage": "https://github.com/JKS42/player-dashboard#readme",
  "bugs": {
    "url": "https://github.com/JKS42/player-dashboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JKS42/player-dashboard.git"
  },
  "license": "ISC",
  "author": "Kian Smith",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:icons": "node scripts/build-icons.js",
    "prestart": "npm run build:icons",
    "start": "electron .",
    "pack": "npm run build:icons && electron-builder --dir",
    "dist": "npm run build:icons && electron-builder",
    "dist:win": "npm run build:icons && electron-builder --win",
    "dist:mac": "npm run build:icons && electron-builder --mac",
    "dist:linux": "npm run build:icons && electron-builder --linux"
  },
  "build": {
    "appId": "com.kiansmith.playerdashboard",
    "productName": "Player Dashboard",
    "directories": {
      "output": "dist",
      "buildResources": "assets/generated"
    },
    "files": [
      "main.js",
      "preload.js",
      "htmlFiles/**/*",
      "assets/generated/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/generated/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/generated/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/generated/icon.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.22",
    "tailwindcss": "^4.3.1"
  }
}
